---
layout: layouts/base.njk
title: Sources
description: The official data sources behind every figure on this site, and what each one covers.
eleventyComputed:
  dataUpdated: "{{ sources.lastUpdated }}"
---
{% from "components/macros.njk" import caveatBox, dataFreshnessBadge %}

<div class="page-intro prose">
  <h1>Sources</h1>
  <p class="lede">Every figure on this site traces back to an official source. These are the sources.</p>
</div>

{{ caveatBox(meta.placeholderNotice, "About these figures") }}

<ul class="source-grid" role="list">
  {%- for s in sources.sources %}
  <li><article class="source-card">
    <h2 class="source-card__name">{{ s.name }}</h2>
    <p class="source-card__publisher">{{ s.publisher }}</p>
    <p>{{ s.covers }}</p>
    <dl class="source-note source-card__meta">
      <div><dt>Updated</dt> <dd>{{ s.updateFrequency }}</dd></div> <div><dt>Confidence</dt> <dd>{{ dataFreshnessBadge(s.confidence_level, true) }}</dd></div>
    </dl>
    <p><a class="block-link" href="{{ s.url }}" rel="noopener">Visit source<span class="visually-hidden">: {{ s.name }}</span></a></p>
  </article></li>
  {%- endfor %}
</ul>

<div class="prose">
  <h2>Confidence levels</h2>
  <dl class="def-list">
    {%- for key, desc in meta.confidenceLevels %}
    <dt>{{ key }}</dt>
    <dd>{{ desc }}</dd>
    {%- endfor %}
  </dl>
</div>
