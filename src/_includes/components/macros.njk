{#
  Reusable components as Nunjucks macros.
  Import in a template with:
    {% from "components/macros.njk" import metricCard, sourceNote, caveatBox %}
#}

{# DataFreshnessBadge: the confidence level. Standing alone it says what it is the confidence
   of; inside sourceNote's list the "Confidence" label already does, so that caller passes bare. #}
{% macro dataFreshnessBadge(confidence, bare) %}
<span class="badge badge--{{ confidence }}">
  <span class="badge__dot" aria-hidden="true"></span>
  {% if not bare %}<span class="visually-hidden">Confidence: </span>{% endif %}{{ confidence }}
</span>
{% endmacro %}

{# SourceNote: where a figure came from, and when. Label-value pairs, so a description list
   that the stylesheet runs as one line. `note` is template-authored prose, so it may carry
   markup and is not escaped. #}
{% macro sourceNote(record, note) %}
<dl class="source-note">
  <div><dt>Source</dt> <dd>{% if record.source_url %}<a href="{{ record.source_url }}" rel="noopener">{{ record.source_name }}</a>{% else %}{{ record.source_name }}{% endif %}</dd></div>
  {%- if record.date %} <div><dt>Figure dated</dt> <dd>{{ record.date | timeTag | safe }}</dd></div>{% endif %}
  {%- if record.retrieved_date %} <div><dt>Retrieved</dt> <dd>{{ record.retrieved_date | timeTag | safe }}</dd></div>{% endif %}
  {%- if record.confidence_level %} <div><dt>Confidence</dt> <dd>{{ dataFreshnessBadge(record.confidence_level, true) }}</dd></div>{% endif %}
  {%- if note %} <div><dt>Note</dt> <dd>{{ note | safe }}</dd></div>{% endif %}
</dl>
{% endmacro %}

{# CaveatBox: a clearly flagged caution. A div with role="note", not an aside, because a caveat about
   the figures is part of the content rather than tangential to it. The title is a real heading so it
   sits in the outline; callers pass the level that fits where the box lands (default h2). #}
{% macro caveatBox(text, heading, level) %}
{%- set tag = level or "h2" %}
<div class="caveat" role="note">
  <{{ tag }} class="caveat__heading">{{ heading or "Important" }}</{{ tag }}>
  <p>{{ text }}</p>
</div>
{% endmacro %}

{# MetricCard: a single headline figure with explanation, source, and an expandable note. #}
{% macro metricCard(metric, formattedValue, extraClass) %}
<article class="metric-card{% if extraClass %} {{ extraClass }}{% endif %}">
  <h3 class="metric-card__label">{{ metric.shortLabel or metric.metric_name }}</h3>
  <p class="metric-card__value">{{ formattedValue }}</p>
  <p class="metric-card__explain">{{ metric.explanation }}</p>
  {% if metric.whatThisMeans %}
  <details class="metric-card__more">
    <summary>What this means</summary>
    <p>{{ metric.whatThisMeans }}</p>
  </details>
  {% endif %}
  {{ sourceNote(metric) }}
</article>
{% endmacro %}

{# MonthlyBody: the shared body of a monthly update (cards, Q&A, source, caveat).
   Rendered both on /monthly/ (latest) and on each /monthly/YYYY-MM/ permalink.
   `questions` is monthlyQuestions.questions, passed in because macros do not see globals. #}
{% macro monthlyBody(u, questions) %}
<section aria-labelledby="borrowing-heading">
  <h2 id="borrowing-heading" class="visually-hidden">Borrowing this month</h2>
  {# A label and one value is a name-value pair, so a description list, not a run of articles. #}
  <dl class="metric-grid metric-grid--compact">
    <div class="metric-card metric-card--mini">
      <dt class="metric-card__label">Borrowing {{ u.borrowing.direction }} in {{ u.month }}</dt>
      <dd class="metric-card__value">£{{ u.borrowing.value | oneDp }} bn</dd>
    </div>
    <div class="metric-card metric-card--mini">
      <dt class="metric-card__label">Versus the same month last year</dt>
      <dd class="metric-card__value">{{ u.borrowing.vsLastYear }}</dd>
    </div>
    <div class="metric-card metric-card--mini">
      <dt class="metric-card__label">Versus the official forecast</dt>
      <dd class="metric-card__value">{{ u.borrowing.vsForecast }}</dd>
    </div>
  </dl>
</section>

<div class="prose">
  <h2 id="qa-heading">What changed, and why</h2>
  <dl class="def-list">
    {%- for q in questions %}
    <dt>{{ q.question }}</dt>
    <dd>{{ u.answers[q.key] }}</dd>
    {%- endfor %}
  </dl>
</div>

{{ sourceNote(u) }}

{{ caveatBox("One month is a weak guide to the year. Monthly figures are volatile, seasonal, and routinely revised as fuller data arrives. Read the direction, not the decimal.", "A note on monthly figures") }}
{% endmacro %}

{# GlossaryTerm: a defined term with its definition. #}
{% macro glossaryTerm(term) %}
<div class="glossary-term" id="term-{{ term.id }}">
  <dt class="glossary-term__name">{{ term.term }}</dt>
  <dd class="glossary-term__def">{{ term.definition }}</dd>
</div>
{% endmacro %}
