---
layout: layouts/base.njk
title: Historical timeline
description: How UK government debt, borrowing, and debt interest have changed over time, with neutral event markers.
eleventyComputed:
  dataUpdated: "{{ [dashboard.lastUpdated, assumptions.translator.lastUpdated] | latestOf }}"
---
{% from "components/macros.njk" import caveatBox, dataFreshnessBadge, sourceNote %}

{# The current-year point comes from the dashboard, the single source of truth. #}
{% set ndNow = dashboard.metrics | findBy("id", "net-debt") %}
{% set dgNow = dashboard.metrics | findBy("id", "debt-gdp") %}
{% set diNow = dashboard.metrics | findBy("id", "debt-interest") %}
{% set bwNow = assumptions.translator.annualBorrowingGbpBillion %}

<div class="page-intro prose">
  <h1>Historical timeline</h1>
  <p class="lede">UK debt over the long run. Switch the measure and the period; every point is also listed in the table below.</p>
</div>

<div class="chart-controls">
  <fieldset>
    <legend>Measure</legend>
    <div class="radio-row">
      <label><input type="radio" name="measure" value="debtToGdp" checked> Debt (% of GDP)</label>
      <label><input type="radio" name="measure" value="debtGbp"> Debt (£)</label>
      <label><input type="radio" name="measure" value="borrowingGbp"> Borrowing (£)</label>
      <label><input type="radio" name="measure" value="interestGbp"> Interest (£)</label>
    </div>
  </fieldset>
  <div class="field field--inline">
    <label for="period">Period</label>
    <select id="period" name="period">
      <option value="1700">Since 1700</option>
      <option value="1900">Since 1900</option>
      <option value="1945">Since 1945</option>
      <option value="1979" selected>Since 1979</option>{# the summary paragraph's default year above must match this #}
      <option value="2008">Since 2008</option>
    </select>
  </div>
</div>

<p id="period-note" class="visually-hidden" role="status"></p>

{# The summary sits before the figure, outside it, so a screen reader meets what the chart shows
   before the image; inside the figure it was skipped or read only as a hint. The script keeps
   the measure and start year current. #}
<p class="prose">The chart below shows <span id="chart-measure-label">debt as a share of GDP</span> since <span id="chart-start">1979</span>. <a href="#timeline-table">The same data is in the table below.</a></p>

<figure class="chart">
  <figcaption id="chart-caption" class="chart__caption"><h2>UK debt over time</h2></figcaption>
  <div id="chart" class="chart__canvas">
    <!-- SVG injected by JS with aria-hidden. The script gives this container role="img" and its name
         when it draws, so without JS it is an empty box and not an image named "Line chart". The
         table below is the accessible alternative. -->
  </div>
</figure>

<div class="timeline-events">
  <h2 id="events-heading">Event markers</h2>
  <ul class="event-list">
    {%- for e in events.events %}
    <li class="event-list__item">
      <span class="event-list__year">{{ e.year }}</span>
      <span class="event-list__body"><strong>{{ e.title }}</strong>: {{ e.summary }}</span>
    </li>
    {%- endfor %}
  </ul>
</div>

<details class="data-table-wrap" open>
  <summary>Show the data as a table</summary>
  <div class="table-scroll" tabindex="0" role="region" aria-label="UK debt time series" id="timeline-table">
  <table class="data-table">
    <caption>UK debt time series. Values before about 2010 are best-estimate reconstructions; each row carries its own confidence level.</caption>
    <thead>
      <tr>
        <th scope="col">Year</th>
        <th scope="col" class="num">Debt (% GDP)</th>
        <th scope="col" class="num">Debt (£ bn)</th>
        <th scope="col" class="num">Borrowing (£ bn)</th>
        <th scope="col" class="num">Interest (£ bn)</th>
        <th scope="col">Confidence</th>
      </tr>
    </thead>
    <tbody>
      {%- for d in debtTimeseries.series %}
      <tr>
        <th scope="row">{{ d.year }}</th>
        <td class="num">{{ d.debtToGdp if d.debtToGdp !== null else "n/a" }}</td>
        <td class="num">{{ d.debtGbp | number if d.debtGbp !== null else "n/a" }}</td>
        <td class="num">{{ d.borrowingGbp | number if d.borrowingGbp !== null else "n/a" }}</td>
        <td class="num">{{ d.interestGbp | number if d.interestGbp !== null else "n/a" }}</td>
        <td>{{ d.confidence_level }}</td>
      </tr>
      {%- endfor %}
      <tr>
        <th scope="row">{{ dashboard.referencePeriod | yearOf }}</th>
        <td class="num">{{ dgNow.value }}</td>
        <td class="num">{{ ndNow.value | number }}</td>
        <td class="num">{{ bwNow | number }}</td>
        <td class="num">{{ diNow.value | number }} <span class="muted">(forecast)</span></td>
        <td>{{ ndNow.confidence_level }}; interest {{ diNow.confidence_level }}</td>
      </tr>
    </tbody>
  </table>
  </div>
</details>

{{ sourceNote({ source_name: debtTimeseries.source_name, source_url: debtTimeseries.source_url, retrieved_date: debtTimeseries.retrieved_date }, "The current-year row comes from the dashboard's own records; its interest figure is the OBR's " + diNow.period + " forecast.") }}

{{ caveatBox(debtTimeseries.note, "About this series") }}

<script id="timeline-data" type="application/json">
{
  "series": {{ debtTimeseries.series | jsonScript | safe }},
  "current": { "year": {{ dashboard.referencePeriod | yearOf }}, "debtToGdp": {{ dgNow.value }}, "debtGbp": {{ ndNow.value }}, "borrowingGbp": {{ bwNow }}, "interestGbp": {{ diNow.value }} },
  "events": {{ events.events | jsonScript | safe }}
}
</script>
<script src="{{ '/assets/js/timeline.js' | url }}" defer></script>
