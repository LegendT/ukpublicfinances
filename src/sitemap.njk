---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}
  {%- if item.url and item.url.endsWith("/") %}
  {#- Same expression as base.njk, so a page's canonical and its sitemap entry
      cannot disagree. A page that canonicalises elsewhere is left out: its real
      address is already listed, and naming both invites a duplicate. Anything
      dropped here must be named in .pa11yci.json, because the accessibility run
      takes its routes from this file. -#}
  {%- set canonical = item.data.canonicalUrl or (site.url + item.url) %}
  {%- if canonical == site.url + item.url %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    {#- Only pages backed by dated data carry a lastmod. Falling back to the
        file date restamped every page on every deploy, because Netlify builds
        from a fresh clone. No date is better than a date that is not true. -#}
    {%- if item.data.dataUpdated %}
    <lastmod>{{ item.data.dataUpdated | isoDate }}</lastmod>
    {%- endif %}
  </url>
  {%- endif %}
  {%- endif %}
{%- endfor %}
{#- The monthly permalinks are excluded from collections (they are a paginated
    template), so emit each month explicitly from the data. -#}
{%- for u in monthlyUpdates.updates %}
  <url>
    <loc>{{ site.url }}/monthly/{{ u.id }}/</loc>
    <lastmod>{{ u.published | isoDate }}</lastmod>
  </url>
{%- endfor %}
</urlset>
